{
  "manifest_version": 3,
  "name": "Dev Server Debug Headers",
  "description": "Add or modify request headers for dev server debugging with configurable initiator domains.",
  "version": "0.1.0",
  "permissions": ["declarativeNetRequestWithHostAccess", "storage", "tabs"],
  "host_permissions": ["<all_urls>", "ws://*/*", "wss://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "src/options.html",
  "action": {
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    },
    "default_title": "Dev Server Debug Headers",
    "default_popup": "src/options.html"
  }
}
